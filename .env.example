# Discord bot identities — https://discord.com/developers/applications
# One identity can only hold one voice connection per guild (a Discord
# platform limit), so serving multiple voice channels in the same guild
# simultaneously requires multiple identities here. Each numbered identity
# must be its own separate Discord application/bot user, invited to the
# server individually (bot + applications.commands scopes). At least
# DISCORD_TOKEN_1/DISCORD_APPLICATION_ID_1 is required; add _2, _3, ... for
# more identities, numbered contiguously from 1.
DISCORD_TOKEN_1=
DISCORD_APPLICATION_ID_1=
# DISCORD_TOKEN_2=
# DISCORD_APPLICATION_ID_2=

# Optional. Set to a guild ID for fast guild-scoped slash command
# registration during dev; omit for global registration.
DISCORD_GUILD_ID=

# SQLite database used to persist per-guild playback settings (volume).
DATABASE_URL=sqlite://apollo.db

# Optional: path to a Netscape-format cookies.txt (export from a real
# logged-in browser session, e.g. via a "Get cookies.txt" extension).
# Passed to yt-dlp as --cookies. Increasingly necessary: YouTube requires a
# proof-of-origin signal from a real browser before serving a stream (or
# even search results) to yt-dlp, especially from a datacenter/cloud host
# IP — without this, requests can fail with "Sign in to confirm you're not
# a bot".
YT_DLP_COOKIES_FILE=

# Optional: max tracks imported from a single playlist. Defaults to 500.
PLAYLIST_TRACK_LIMIT=

# Optional: log verbosity (tracing-subscriber EnvFilter syntax)
RUST_LOG=info,apollo=debug
