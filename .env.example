# Discord bot credentials — https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# Google OAuth2 client — https://console.cloud.google.com/apis/credentials
# Must have the YouTube Data API v3 enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match a redirect URI registered on the Google OAuth2 client.
# The bot runs a small local web server to receive this callback.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth/callback

# Optional: log verbosity (tracing-subscriber EnvFilter syntax)
RUST_LOG=info,apollo=debug
