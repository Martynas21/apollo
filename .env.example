# Discord bot credentials — https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# Optional. Set to a guild ID for fast guild-scoped slash command
# registration during dev; omit for global registration.
DISCORD_GUILD_ID=

# Google OAuth2 client — https://console.cloud.google.com/apis/credentials
# Must have the YouTube Data API v3 enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match a redirect URI registered on the Google OAuth2 client.
# The bot runs a small local web server to receive this callback.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth/callback

# SQLite database used to persist linked accounts' OAuth2 tokens.
DATABASE_URL=sqlite://apollo.db

# Optional: path to a Netscape-format cookies.txt (export from a real
# logged-in browser session, e.g. via a "Get cookies.txt" extension).
# Passed to yt-dlp as --cookies. Increasingly necessary: YouTube requires a
# proof-of-origin signal from a real browser before serving a stream to
# yt-dlp, especially from a datacenter/cloud host IP — without this, video
# resolution can fail with "Sign in to confirm you're not a bot".
YT_DLP_COOKIES_FILE=

# Optional: log verbosity (tracing-subscriber EnvFilter syntax)
RUST_LOG=info,apollo=debug
