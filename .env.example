# Discord bot credentials — https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# Optional. There are no slash commands to register — this only controls
# where startup clears any commands a pre-existing install registered
# before they were removed. Set to that guild ID (guild-scoped) or leave
# unset (global) to match how they were originally registered.
DISCORD_GUILD_ID=

# SQLite database used to persist per-guild playback settings (volume).
DATABASE_URL=sqlite://apollo.db

# Optional: path to a Netscape-format cookies.txt (export from a real
# logged-in browser session, e.g. via a "Get cookies.txt" extension).
# Passed to yt-dlp as --cookies. Increasingly necessary: YouTube requires a
# proof-of-origin signal from a real browser before serving a stream (or
# even search results) to yt-dlp, especially from a datacenter/cloud host
# IP — without this, requests can fail with "Sign in to confirm you're not
# a bot".
YT_DLP_COOKIES_FILE=

# Optional: max tracks imported from a single playlist. Defaults to 500.
PLAYLIST_TRACK_LIMIT=

# Optional: log verbosity (tracing-subscriber EnvFilter syntax)
RUST_LOG=info,apollo=debug

# Optional: where apollo-audio-worker listens / apollo connects (TCP
# host:port) for the voice-playback IPC channel. Default shown matches
# compose.yaml; override to 127.0.0.1:7878 if running both processes
# directly on the same machine instead of in Docker.
AUDIO_WORKER_SOCKET=audio-worker:7878

# Optional: address the web dashboard listens on. Defaults to
# 127.0.0.1:8787 (localhost only). Only change this to something
# non-localhost (e.g. 0.0.0.0:8787) if you're putting a reverse proxy
# with TLS in front of it — the dashboard itself speaks plain HTTP.
DASHBOARD_BIND_ADDR=

# Bootstraps the dashboard's first (and, for now, only) login on first
# run — only used while no dashboard account exists yet, so changing
# these later does nothing. Leave both unset to disable the dashboard's
# login entirely (it'll come up but reject every sign-in attempt).
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
