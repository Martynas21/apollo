[Unit]
Description=Apollo Discord music bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=apollo
Group=apollo
WorkingDirectory=/opt/apollo

# Secrets live in this file, not the unit file itself — unit files under
# /etc/systemd/system are commonly world-readable; this one should be
# chmod 600, owned by the apollo user. See README.md's "Production
# secrets" section for alternatives (systemd-creds, a secrets manager).
EnvironmentFile=/opt/apollo/.env

ExecStart=/opt/apollo/apollo
Restart=on-failure
RestartSec=5

# Hardening: the process only needs write access to its own working
# directory (for the SQLite file) and nothing else on the system.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/apollo

[Install]
WantedBy=multi-user.target
